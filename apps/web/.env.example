# =============================================================================
# Cofrial SpA · apps/web (Laravel: portal + CRM)
# Copiar a `.env` y completar. `.env` NUNCA se sube al repositorio.
# Debe mantenerse alineado con el `.env.example` de la raíz (sección «Aplicación
# web») y con docs/SECURITY.md. Ningún valor es un secreto real.
# =============================================================================

APP_NAME="Cofrial"
APP_ENV=local                 # local | production
# php artisan key:generate
APP_KEY=
APP_DEBUG=true                # false en AWS
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Santiago
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

# Modo mantenimiento compartido entre las dos EC2 (ADR-0005).
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug               # warning en AWS

# --- Base de datos (PostgreSQL 16 + PostGIS) ---------------------------------
# Fuera de Docker: 127.0.0.1. En Docker Compose (T-002): `db`. En AWS: endpoint de RDS.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cofrial
DB_SSLMODE=prefer             # `require` (o verify-full) contra RDS
DB_CONNECT_TIMEOUT=3          # segundos; /health responde 503 si se supera
DB_USERNAME=app_rw
DB_PASSWORD=cambiar-en-local

# Sesiones, caché y colas viven en la base para que cualquier EC2 atienda (ADR-0005).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Correo --------------------------------------------------------------------
MAIL_MAILER=log               # en local los correos van al log
MAIL_FROM_ADDRESS=no-responder@cofrial.example
MAIL_FROM_NAME="${APP_NAME}"
