# =============================================================================
# Cofrial SpA · Plataforma de transformación digital
# Copiar a `.env` y completar. `.env` NUNCA se sube al repositorio.
# Ningún valor de este archivo es un secreto real: son marcadores de posición.
# Referencias: docs/SECURITY.md, docs/ARCHITECTURE.md
# =============================================================================

# --- Aplicación web (apps/web · Laravel: portal + CRM) -----------------------
APP_NAME="Cofrial"
APP_ENV=local                 # local | production
# php artisan key:generate (en Docker local, si queda vacía se genera sola)
APP_KEY=
APP_DEBUG=true                # false en AWS
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Santiago
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=cache   # mantenimiento compartido entre las dos EC2
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug               # warning en AWS

# --- Base de datos (PostgreSQL 16 + PostGIS) ---------------------------------
# Local: contenedor `db`. AWS: endpoint de RDS (subred privada, sin acceso público).
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=cofrial
DB_SSLMODE=prefer             # `require` (o verify-full) contra RDS
DB_CONNECT_TIMEOUT=3          # segundos; /health responde 503 si se supera

# Usuario maestro: SOLO para crear roles y correr migraciones (db/roles.sql).
DB_ADMIN_USERNAME=postgres
DB_ADMIN_PASSWORD=cambiar-en-local

# Usuario de la aplicación (lectura/escritura sobre el esquema de negocio).
DB_USERNAME=app_rw
DB_PASSWORD=cambiar-en-local

# Sesiones, caché y colas viven en la base para que cualquier EC2 atienda (ADR-0005).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false # true en AWS (HTTPS en el ALB): cookie solo por HTTPS
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Reglas de negocio parametrizables (docs/BUSINESS_RULES.md) --------------
PEDIDO_MINIMO_B2C=20000       # RN-03 (CLP)
PEDIDO_MINIMO_B2B=150000      # RN-03 (CLP, neto)
RESERVA_STOCK_MINUTOS_B2C=30  # RN-04
CARRITO_ABANDONO_HORAS=24     # RN-04
OPORTUNIDAD_SIN_ACTIVIDAD_DIAS=15  # panel del CRM
CONVERSION_VENTANA_DIAS=90         # panel del CRM
IVA_PCT=19

# --- Simulador IoT (apps/iot-simulator · Docker en nodo dedicado) ------------
# Escribe directo en la base con un usuario que solo puede insertar telemetría/alertas.
IOT_DB_USERNAME=iot_writer
IOT_DB_PASSWORD=cambiar-en-local
IOT_INTERVALO_SEGUNDOS=30     # una lectura por camión cada 30 s
IOT_CAMIONES_POR_CONTENEDOR=10
IOT_CONTENEDORES=5            # 5 x 10 = 50 camiones
IOT_PROB_RUPTURA_FRIO=0.02    # probabilidad por camión y por ciclo de iniciar un episodio de ruptura
IOT_RUPTURA_CICLOS_MIN=4      # duración de un episodio, en lecturas
IOT_RUPTURA_CICLOS_MAX=10
IOT_TEMP_MIN_DEFECTO=0        # rango (°C) si el camión no tiene despacho en ruta
IOT_TEMP_MAX_DEFECTO=5
# opcional: fija la aleatoriedad para demos reproducibles
IOT_SEMILLA=
# opcional (demo): camiones que entran en ruptura al arrancar y con `docker kill -s USR1`
IOT_FORZAR_RUPTURA=
# En local el simulador usa DB_HOST/DB_PORT/DB_DATABASE/DB_SSLMODE. En el nodo IoT
# (compose.iot.yml) se definen IOT_DB_HOST (endpoint de RDS) e IOT_DB_SSLMODE=require.

# --- Business Intelligence (Grafana OSS en /bi) ------------------------------
BI_DB_USERNAME=bi_reader
BI_DB_PASSWORD=cambiar-en-local
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=cambiar-en-local
GF_SERVER_ROOT_URL=http://localhost:8080/bi
GF_SERVER_SERVE_FROM_SUB_PATH=true
# Base interna de Grafana (usuarios, dashboards) en la misma instancia PostgreSQL (ADR-0010).
GF_DATABASE_TYPE=postgres
GF_DATABASE_HOST=db:5432
GF_DATABASE_NAME=grafana
GF_DATABASE_USER=grafana_rw
GF_DATABASE_PASSWORD=cambiar-en-local
# También es el modo TLS del datasource de negocio (bi_reader), que está en la misma instancia.
GF_DATABASE_SSL_MODE=disable  # `require` contra RDS

# --- IA externa de capa gratuita (ADR-0015) ----------------------------------
# Nunca se envían RUT ni nombres a la API (RN-11). Si falla, el ticket queda manual.
AI_ENABLED=true
# p. ej. gemini | groq (se decide en ADR-0015)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SEGUNDOS=10

# --- Correo (notificaciones de la aplicación) --------------------------------
MAIL_MAILER=log               # en local los correos van al log
MAIL_FROM_ADDRESS=no-responder@cofrial.example
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS (solo para scripts de infra/aws; las credenciales del Learner Lab ---
# --- son temporales y se cargan con `aws configure`, no en este archivo) -----
AWS_REGION=us-east-1
ALERTAS_EMAIL=equipo@example.com   # suscriptor del tópico SNS de alarmas
SSH_CIDR_PERMITIDO=0.0.0.0/32      # IP pública del equipo en formato /32
