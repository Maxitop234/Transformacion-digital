# syntax=docker/dockerfile:1
# Imágenes de producción de la aplicación (T-024). Contexto: raíz del repositorio.
#   docker build -f infra/docker/web/Dockerfile.prod --target app   -t cofrial/web:prod .
#   docker build -f infra/docker/web/Dockerfile.prod --target nginx -t cofrial/nginx:prod .
# A diferencia de la de desarrollo, el código, las dependencias y los assets
# compilados van dentro de la imagen; nada se monta desde el disco del servidor.

# --- Código limpio + dependencias de Composer (sin las de desarrollo) ------------
# Se borra todo lo local antes de instalar, aunque el constructor ignore el
# .dockerignore: secretos, dependencias y compilados no pasan a la imagen.
FROM composer:2.8 AS vendor
WORKDIR /app
COPY apps/web ./
RUN rm -rf .env .env.* vendor node_modules public/build public/hot .phpunit.result.cache \
        bootstrap/cache/*.php storage/*.key storage/logs/* \
        storage/framework/*.php storage/framework/*.json storage/framework/down storage/framework/schedule-* \
        storage/framework/cache/* storage/framework/sessions/* storage/framework/testing/* storage/framework/views/*
# Las extensiones de PHP están en la imagen final, no en esta.
RUN composer install --no-dev --no-interaction --no-progress --prefer-dist \
        --no-scripts --optimize-autoloader --ignore-platform-reqs

# --- CSS y JS compilados con Vite ------------------------------------------------
FROM node:22.23.3-alpine AS assets
WORKDIR /app
# Tailwind lee vistas de vendor (paginación) para no omitir clases.
COPY --from=vendor /app ./
RUN npm ci --no-audit --no-fund && npx vite build && rm -rf node_modules

# --- PHP-FPM con la aplicación ----------------------------------------------------
FROM php:8.4.26-fpm-bookworm AS app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libpq-dev libicu-dev libzip-dev libfcgi-bin postgresql-client \
    && docker-php-ext-install -j2 pdo_pgsql pgsql intl zip opcache \
    && rm -rf /var/lib/apt/lists/*

COPY infra/docker/web/php.ini /usr/local/etc/php/conf.d/zz-cofrial.ini
COPY infra/docker/web/php.prod.ini /usr/local/etc/php/conf.d/zz-cofrial-prod.ini
COPY infra/docker/web/php-fpm.conf /usr/local/etc/php-fpm.d/zz-cofrial.conf
COPY infra/docker/web/entrypoint.sh /usr/local/bin/cofrial-entrypoint
COPY infra/docker/web/healthcheck.sh /usr/local/bin/cofrial-healthcheck
RUN chmod 755 /usr/local/bin/cofrial-entrypoint /usr/local/bin/cofrial-healthcheck

WORKDIR /var/www/html
COPY --chown=www-data:www-data --from=assets /app ./
# Roles, permisos y vistas que se reaplican después de migrar (db/aplicar.sh).
COPY db /var/www/db

USER www-data
RUN php artisan package:discover --ansi

ENTRYPOINT ["cofrial-entrypoint"]
CMD ["php-fpm"]

# --- Nginx con los archivos públicos -----------------------------------------------
FROM nginx:1.30.5-alpine AS nginx
COPY infra/docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY infra/docker/nginx/websocket.conf /etc/nginx/conf.d/00-websocket.conf
COPY --from=app /var/www/html/public /var/www/html/public
