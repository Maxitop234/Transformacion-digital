    {
      "id": 14,
      "type": "timeseries",
      "title": "Temperatura de cámara por camión",
      "description": "Temperatura promedio por intervalo. Las líneas marcan el rango refrigerado por defecto (0 a 5 °C). Filtra con la variable Camión. Fuente: bi_telemetria.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cofrial-bi"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cofrial-bi"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(fecha_hora, $__interval), camion_id AS metric, avg(temp_camara) AS temp\nFROM bi_telemetria\nWHERE $__timeFilter(fecha_hora) AND camion_id IN ($camion)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "interval": "30s",
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "transparent",
